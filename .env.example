# AWS region for SSM Parameter Store (DB credentials live there, not here)
AWS_REGION=eu-west-1

# AWS region for Bedrock (override if the model isn't available in AWS_REGION)
BEDROCK_REGION=eu-west-1

# DB port (MySQL — the database itself is selected per-request per tenant)
DB_PORT=3306


FORWARD_API_PORT=5777

# Bedrock model id
BEDROCK_MODEL_ID=anthropic.claude-sonnet-5

# Which Laravel backend environment this deployment talks to for the
# ai-credit-usage webhook: local | development | testing | production
APP_ENV=local

# Read-only replica DB credentials
LEARNOSTIC_READONLY_DB_USERNAME=
LEARNOSTIC_READONLY_DB_PASSWORD=
LEARNOSTIC_DB_REPLICA_ENDPOINT=

# Optional — Langfuse tracing (question/SQL/answer). Tracing is silently
# skipped if these are left blank.
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=
